<UserControl x:Class="CombatPad.Components.DraggableItemComponent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CombatPad.Components"
             mc:Ignorable="d" 
             d:DesignHeight="35" d:DesignWidth="250">
    <Grid>
        <Rectangle RadiusX="15" RadiusY="15" StrokeThickness="3" 
                   Stroke="{Binding Converter={StaticResource typeToColor}}" 
                   Fill="{StaticResource Application.Brushes.Solid.Parchment}"/>
        <Rectangle Width="50" RadiusX="15" RadiusY="15" HorizontalAlignment="Right" 
                   Fill="{Binding Converter={StaticResource typeToColor}}"/>
        <Rectangle Width="25" HorizontalAlignment="Right" Margin="40,3" Fill="{StaticResource Application.Brushes.Solid.Parchment}"/>
        <TextBlock Text="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:DraggableItemComponent}}, Path=Item.Label}" 
                   VerticalAlignment="Center" Margin="5,0,40,0" Foreground="{StaticResource Application.Brushes.Solid.Label}"/>
        <TextBlock Text="{Binding Converter={StaticResource shortName}}" HorizontalAlignment="Right" VerticalAlignment="Center"
                   Width="50" TextAlignment="Center" Foreground="{StaticResource Application.Brushes.Solid.Parchment}"/>
    </Grid>
</UserControl>
