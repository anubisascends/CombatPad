<UserControl x:Class="CombatPad.Components.NonPlayerCharacterPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CombatPad.Components" 
             xmlns:classes="clr-namespace:CombatPad.Classes"
             xmlns:models="clr-namespace:CombatPad.Models"
             mc:Ignorable="d" d:Background="White"
             d:DataContext="{d:DesignInstance models:NonPlayerCharacter}"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.Resources>
            <Style TargetType="local:EditableTextBlock">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="Black" />
            </Style>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="1*" />
            
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <Label Foreground="{StaticResource Application.Brushes.Solid.Label}">Name:</Label>
        <local:EditableTextBlock Text="{Binding Label, Mode=TwoWay}" Grid.Column="1" VerticalAlignment="Center" Grid.ColumnSpan="10"/>
        <Rectangle Style="{StaticResource Application.Styles.Rectangle.Line}" Grid.Column="1" Grid.ColumnSpan="10"/>

        <Label Foreground="{StaticResource Application.Brushes.Solid.Label}" Grid.Row="1">Type:</Label>
        <local:EditableTextBlock Text="{Binding Type, Mode=TwoWay}" Grid.Column="1" Grid.Row="1"/>
        <Rectangle Style="{StaticResource Application.Styles.Rectangle.Line}" Grid.Column="1" Grid.Row="1"/>

        <Label Foreground="{StaticResource Application.Brushes.Solid.Label}" Grid.Row="1" Grid.Column="2">Sub Type:</Label>
        <local:EditableTextBlock Text="{Binding SubType, Mode=TwoWay}" Grid.Column="3" Grid.Row="1"/>
        <Rectangle Style="{StaticResource Application.Styles.Rectangle.Line}" Grid.Column="3" Grid.Row="1"/>

        <Label Foreground="{StaticResource Application.Brushes.Solid.Label}" Grid.Row="2">Description:</Label>
        <local:EditableTextBlock Text="{Binding Description, Mode=TwoWay}" Grid.Column="1" Grid.Row="2" Grid.ColumnSpan="10"/>
        <Rectangle Style="{StaticResource Application.Styles.Rectangle.Line}" Grid.Column="1" Grid.Row="2" Grid.ColumnSpan="10"/>
    </Grid>
</UserControl>
