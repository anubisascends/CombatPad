<UserControl x:Class="CombatPad.Components.NonPlayerCharacterPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CombatPad.Components" 
             xmlns:classes="clr-namespace:CombatPad.Classes"
             xmlns:models="clr-namespace:CombatPad.Models"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             mc:Ignorable="d" d:Background="White"
             d:DataContext="{d:DesignInstance models:NonPlayerCharacter}"
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.Resources>
            <Style TargetType="TextBox" BasedOn="{StaticResource Application.Styles.TextBox.Transparent}"/>
        </Grid.Resources>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="auto" />
            <ColumnDefinition Width="1*" />
            
        </Grid.ColumnDefinitions>

        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <!--Name-->
        <Label Foreground="{StaticResource Application.Brushes.Solid.Label}">Name:</Label>
        <TextBox Text="{Binding Label}" Grid.Column="1" Grid.ColumnSpan="10"/>
        <Rectangle Style="{StaticResource Application.Styles.Rectangle.Line}" Grid.Column="1" Grid.ColumnSpan="10"/>

        <!--Type-->
        <Label Foreground="{x:Static SystemColors.ControlTextBrush}" Grid.Row="1">Type:</Label>
        <TextBox Text="{Binding Type, Mode=TwoWay}" Grid.Column="1" Grid.Row="1"/>
        <Rectangle Style="{StaticResource Application.Styles.Rectangle.Line}" Grid.Column="1" Grid.Row="1"/>

        <!--Sub-Type-->
        <Label Foreground="{x:Static SystemColors.ControlTextBrush}" Grid.Row="1" Grid.Column="2">Sub Type:</Label>
        <TextBox Text="{Binding SubType, Mode=TwoWay}" Grid.Column="3" Grid.Row="1"/>
        <Rectangle Style="{StaticResource Application.Styles.Rectangle.Line}" Grid.Column="3" Grid.Row="1"/>

        <!--Description-->
        <Label Foreground="{x:Static SystemColors.ControlTextBrush}" Grid.Row="2">Description:</Label>
        <TextBox Text="{Binding Description, Mode=TwoWay}" Grid.Column="1" Grid.Row="2" Grid.ColumnSpan="10"/>
        <Rectangle Style="{StaticResource Application.Styles.Rectangle.Line}" Grid.Column="1" Grid.Row="2" Grid.ColumnSpan="10"/>
        
        <!--Ability Scores-->
        <GroupBox Header="Abilities" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="10" Height="120"
                  mah:HeaderedControlHelper.HeaderBackground="{StaticResource Application.Brushes.Gradient.Red}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <local:AbilityScoreComponent Title="Strength" Score="{Binding Strength, Mode=TwoWay}" />
                <local:AbilityScoreComponent Title="Dexterity" Score="{Binding Dexterity, Mode=TwoWay}" Grid.Column="1"/>
                <local:AbilityScoreComponent Title="Constitution" Score="{Binding Constitution, Mode=TwoWay}" Grid.Column="2"/>
                <local:AbilityScoreComponent Title="Intelligence" Score="{Binding Intelligence, Mode=TwoWay}" Grid.Column="3"/>
                <local:AbilityScoreComponent Title="Wisdom" Score="{Binding Wisdom, Mode=TwoWay}" Grid.Column="4"/>
                <local:AbilityScoreComponent Title="Charisma" Score="{Binding Charisma, Mode=TwoWay}" Grid.Column="5"/>
            </Grid>
        </GroupBox>
    </Grid>
</UserControl>
