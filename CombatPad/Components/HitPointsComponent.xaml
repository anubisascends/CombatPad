<UserControl x:Class="CombatPad.Components.HitPointsComponent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CombatPad.Components"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d" d:Background="White"
             d:DesignHeight="150" d:DesignWidth="250">
    <GroupBox mah:HeaderedControlHelper.HeaderBackground="{StaticResource Application.Brushes.Gradient.Red}" >
        <GroupBox.Header>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="HIT POINTS"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                    <icons:PackIconBoxIcons Kind="RegularReset" ToolTip="Reset Damage" 
                                            MouseDown="PackIconMaterial_MouseDown"
                                            Cursor="Hand"/>
                </StackPanel>
            </Grid>
        </GroupBox.Header>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*" />
                <ColumnDefinition Width="1*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="1*" />
            </Grid.RowDefinitions>

            <Label HorizontalAlignment="Center" Foreground="{x:Static SystemColors.ControlTextBrush}" FontSize="8">Maximum</Label>
            <TextBox Style="{StaticResource Application.Styles.TextBox.AbilityScore}"
                     Text="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:HitPointsComponent}}, Path=Maximum, Mode=TwoWay, StringFormat={}{0:N0}}"
                     Grid.Row="1"
                     FontSize="20"
                     d:Text="9,999"/>

            <Label Grid.Column="1" HorizontalAlignment="Center" Foreground="{x:Static SystemColors.ControlTextBrush}" FontSize="8">Current</Label>
            <Label Grid.Column="1" 
                   Grid.Row="1" 
                   HorizontalAlignment="Center" 
                   VerticalAlignment="Center" 
                   Foreground="{x:Static SystemColors.ControlTextBrush}"
                   FontSize="20"
                   d:Content="9,999">
                <Label.Content>
                    <MultiBinding Converter="{StaticResource hpConverter}">
                        <MultiBinding.Bindings>
                            <Binding RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType={x:Type local:HitPointsComponent}}" Path="Maximum"/>
                            <Binding RelativeSource="{RelativeSource Mode=FindAncestor, AncestorType={x:Type local:HitPointsComponent}}" Path="Damage"/>
                        </MultiBinding.Bindings>
                    </MultiBinding>
                </Label.Content>
            </Label>

            <Label Grid.Column="2" HorizontalAlignment="Center" Foreground="{x:Static SystemColors.ControlTextBrush}" FontSize="8">Damage</Label>
            <TextBox Style="{StaticResource Application.Styles.TextBox.AbilityScore}" 
                     Text="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:HitPointsComponent}}, Path=Damage, Mode=TwoWay, StringFormat={}{0:N0}}" 
                     Grid.Row="1" 
                     Grid.Column="2"
                     FontSize="20" 
                     d:Text="9,999"/>
        </Grid>
    </GroupBox>
</UserControl>
