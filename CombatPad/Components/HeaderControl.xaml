<UserControl x:Class="CombatPad.Components.HeaderControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CombatPad.Components"
             mc:Ignorable="d" Background="{StaticResource Application.Brushes.Gradient.Red}"
             d:DesignHeight="50" d:DesignWidth="350">
    <UserControl.Resources>
        <Style TargetType="Label">
            <Setter Property="Foreground" Value="{StaticResource Application.Brushes.Solid.Parchment}" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1*" />
            <ColumnDefinition Width="25" />
            <ColumnDefinition Width="25" />
            <ColumnDefinition Width="25" />
            <ColumnDefinition Width="25" />
        </Grid.ColumnDefinitions>

        <Label>Initiative</Label>
        <Label Grid.Column="1">
            <Label.LayoutTransform>
                <RotateTransform Angle="90" />
            </Label.LayoutTransform>
            <Label.Content>Delay</Label.Content>
        </Label>

        <Label Grid.Column="2" Grid.ColumnSpan="3" VerticalAlignment="Top">Dying</Label>
        <Label Grid.Column="2" VerticalAlignment="Bottom">1</Label>
        <Label Grid.Column="3" VerticalAlignment="Bottom">2</Label>
        <Label Grid.Column="4" VerticalAlignment="Bottom">3</Label>
    </Grid>
</UserControl>
