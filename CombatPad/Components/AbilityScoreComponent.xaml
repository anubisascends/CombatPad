<UserControl x:Class="CombatPad.Components.AbilityScoreComponent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CombatPad.Components" xmlns:models="clr-namespace:CombatPad.Models"
             xmlns:icons="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d" d:Background="White"
             d:DataContext="{d:DesignInstance models:NonPlayerCharacter}"
             d:DesignHeight="75" d:DesignWidth="118">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>
        <Grid.Resources>
            <Style TargetType="Label">
                <Setter Property="Foreground" Value="{x:Static SystemColors.ControlTextBrush}" />
            </Style>
        </Grid.Resources>

        <Rectangle Grid.RowSpan="10" Grid.ColumnSpan="10" Stroke="{StaticResource MahApps.Brushes.Accent}"/>

        <Label HorizontalAlignment="Center" FontSize="12" d:Content="Constitution" 
               Content="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:AbilityScoreComponent}}, Path=Title}"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*"/>
                <ColumnDefinition Width="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:AbilityScoreComponent}}, Path=ShowModifier, Converter={StaticResource boolToWidth}}"/>
                <ColumnDefinition Width="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:AbilityScoreComponent}}, Path=ShowSave, Converter={StaticResource boolToWidth}}"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto" />
                <RowDefinition Height="1*" />
            </Grid.RowDefinitions>

            <Label FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Top"
                   MouseDown="Score_MouseDown" Cursor="Hand">score</Label>
            <Label Grid.Column="1" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Top"
                   MouseDown="Modifier_MouseDown" Cursor="Hand">modifier</Label>
            <Label Grid.Column="2" FontSize="8" HorizontalAlignment="Center" VerticalAlignment="Top"
                   MouseDown="Save_MouseDown" Cursor="Hand">save</Label>
            <TextBox Text="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:AbilityScoreComponent}}, Path=Score}"
                     Style="{StaticResource Application.Styles.TextBox.AbilityScore}" d:Text="18" Grid.Row="1"/>
            <TextBlock Text="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:AbilityScoreComponent}}, Path=Score, Converter={StaticResource Application.Converters.Modifier}}"
                       HorizontalAlignment="Center" Foreground="{x:Static SystemColors.ControlTextBrush}" FontSize="16" Grid.Column="1" d:Text="4"
                       VerticalAlignment="Center" Grid.Row="1"/>
            <TextBox Text="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:AbilityScoreComponent}}, Path=Save}" 
                     Style="{StaticResource Application.Styles.TextBox.AbilityScore}" d:Text="4" Grid.Row="1" Grid.Column="2"/>
        </Grid>
    </Grid>
</UserControl>
