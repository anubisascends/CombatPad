<UserControl x:Class="CombatPad.Components.AbilityScoreComponent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:CombatPad.Components" xmlns:models="clr-namespace:CombatPad.Models"
             mc:Ignorable="d" d:Background="White"
             d:DataContext="{d:DesignInstance models:NonPlayerCharacter}"
             d:DesignHeight="150" d:DesignWidth="150">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="1*" />
        </Grid.RowDefinitions>
        <Grid.Resources>
            <Style TargetType="Label">
                <Setter Property="Foreground" Value="{x:Static SystemColors.ControlTextBrush}" />
            </Style>
        </Grid.Resources>

        <Label HorizontalAlignment="Center" FontSize="12" d:Content="Constitution" 
               Content="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:AbilityScoreComponent}}, Path=Title}"/>

        <TextBox Style="{StaticResource Application.Styles.TextBox.AbilityScore}" Grid.Row="1"
                 Text="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:AbilityScoreComponent}}, Path=Score}"/>
    </Grid>
</UserControl>
