<mah:MetroWindow  xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                  x:Class="CombatPad.Views.RootView"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:icon="http://metro.mahapps.com/winfx/xaml/iconpacks"
                  xmlns:local="clr-namespace:CombatPad.Views" 
                  xmlns:controls="clr-namespace:WPF.JoshSmith.Controls;assembly=WPF.JoshSmith.Controls.DragCanvas" 
                  xmlns:classes="clr-namespace:CombatPad.Classes" 
                  xmlns:components="clr-namespace:CombatPad.Components"
                  xmlns:Dialog="clr-namespace:MahApps.Metro.Controls.Dialogs;assembly=MahApps.Metro"
                  Dialog:DialogParticipation.Register="{Binding ViewModel}"
                  mc:Ignorable="d" d:DataContext="{d:DesignInstance local:RootView}"
                  
                  Title="Combat Pad" Height="600" MinHeight="600" Width="1000" MinWidth="1000">
    <Window.InputBindings>
        <KeyBinding Command="{Binding ViewModel.NewCommand}" Key="N" Modifiers="Ctrl"/>
        <KeyBinding Command="{Binding ViewModel.LoadCommand}" Key="O" Modifiers="Ctrl"/>
        <KeyBinding Command="{Binding ViewModel.SaveCommand}" Key="S" Modifiers="Ctrl"/>
        <KeyBinding Command="{Binding ViewModel.SaveAsCommand}" Key="S" Modifiers="Shift+Ctrl"/>
        <KeyBinding Command="{Binding ViewModel.ImportCommand}" Key="I" Modifiers="Ctrl+Shift"/>
    </Window.InputBindings>
    <mah:MetroWindow.LeftWindowCommands>
        <mah:WindowCommands>
            <Button Command="{Binding ViewModel.NewCommand}">
                <icon:FontAwesome Kind="FileRegular"/>
            </Button>
            <Button Command="{Binding ViewModel.LoadCommand}">
                <icon:FontAwesome Kind="FolderOpenRegular"/>
            </Button>
            <Button Command="{Binding ViewModel.SaveCommand}">
                <icon:FontAwesome Kind="FloppyDiskRegular"/>
            </Button>
            <Button Command="{Binding ViewModel.SettingsCommand}">
                <icon:FontAwesome Kind="GearSolid"/>
            </Button>
        </mah:WindowCommands>
    </mah:MetroWindow.LeftWindowCommands>
    <mah:MetroWindow.RightWindowCommands>
        <mah:WindowCommands>
            
        </mah:WindowCommands>
    </mah:MetroWindow.RightWindowCommands>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="1*" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="2">
            <Grid.LayoutTransform>
                <ScaleTransform ScaleX="{Binding ViewModel.Zoom}" ScaleY="{Binding ViewModel.Zoom}"/>
            </Grid.LayoutTransform>
            <Grid Background="{StaticResource Application.Brushes.Solid.Parchment}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto" />
                    <ColumnDefinition Width="6.5"/>
                    <ColumnDefinition Width="250" />
                    <ColumnDefinition Width="25" />
                    <ColumnDefinition Width="25" />
                    <ColumnDefinition Width="25" />
                    <ColumnDefinition Width="25" />
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="45" />
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="50" />
                    <RowDefinition Height="1*" />
                </Grid.RowDefinitions>

                <Rectangle Grid.Column="2" Grid.ColumnSpan="5" Fill="{StaticResource Application.Brushes.Gradient.Red}"/>

                <Label Grid.Column="2" HorizontalAlignment="Center" Foreground="{StaticResource Application.Brushes.Solid.Parchment}">Initiative</Label>
                <Label Grid.Column="3" Foreground="#FFEAD8C1" VerticalAlignment="Center">
                    <Label.LayoutTransform>
                        <RotateTransform Angle="90" />
                    </Label.LayoutTransform>
                    <Label.Content>Delay</Label.Content>
                </Label>
                <Label Grid.Column="4" Grid.ColumnSpan="3" HorizontalAlignment="Center" Foreground="#FFEAD8C1">Dying</Label>
                <Label Grid.Column="4" Style="{StaticResource Application.Styles.Label.Header}">1</Label>
                <Label Grid.Column="5" Style="{StaticResource Application.Styles.Label.Header}">2</Label>
                <Label Grid.Column="6" Style="{StaticResource Application.Styles.Label.Header}">3</Label>

                <Rectangle Grid.Column="3" Grid.Row="1" Style="{StaticResource Application.Styles.Rectangle.Circle}"/>
                <Rectangle Grid.Column="4" Grid.Row="1" Style="{StaticResource Application.Styles.Rectangle.Skulls}"/>
                <Rectangle Grid.Column="5" Grid.Row="1" Style="{StaticResource Application.Styles.Rectangle.Skulls}"/>
                <Rectangle Grid.Column="6" Grid.Row="1" Style="{StaticResource Application.Styles.Rectangle.Skulls}"/>

                <Rectangle Grid.RowSpan="2" Grid.Column="0" Stroke="Black" Grid.ColumnSpan="2"/>
                <Rectangle Grid.Row="1" Grid.Column="2" Stroke="Black"/>
                <Rectangle Grid.Row="1" Grid.Column="3" Stroke="Black"/>
                <Rectangle Grid.Row="1" Grid.Column="4" Stroke="Black"/>
                <Rectangle Grid.Row="1" Grid.Column="5" Stroke="Black"/>
                <Rectangle Grid.Row="1" Grid.Column="6" Stroke="Black"/>
                <Rectangle Grid.RowSpan="2" Grid.Column="7" Stroke="Black"/>
                <Rectangle Grid.RowSpan="2" Grid.Column="8" Stroke="Black"/>

                <ItemsControl Grid.Row="1" ItemsSource="{Binding ViewModel.Markers}" d:ItemsSource="{d:SampleData ItemCount=1}" Width="45">
                    <ItemsControl.LayoutTransform>
                        <ScaleTransform ScaleX="{Binding ViewModel.Zoom}" ScaleY="{Binding ViewModel.Zoom}"/>
                    </ItemsControl.LayoutTransform>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid>
                                <icon:PackIconEntypo Kind="ArrowBoldRight" Height="24" Width="24" Foreground="{Binding Color, Converter={StaticResource colorToBrush}}"/>
                                <TextBlock Foreground="BlanchedAlmond" Text="{Binding Label}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <components:MyDragCanvas SelectedItem="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:RootView}}, Path=ViewModel.SelectedCombatItem, Mode=TwoWay}" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>

                <StackPanel Grid.Row="1" Grid.Column="2" VerticalAlignment="Bottom" HorizontalAlignment="Right" Margin="10"
                            Orientation="Horizontal">
                    <Button Margin="2.5" Command="{Binding ViewModel.AddPlayerCharacterCommand}">
                        <icon:GameIcons Kind="TabletopPlayers"/>
                    </Button>
                    <Button Margin="2.5" Command="{Binding ViewModel.AddNonPlayerCharacterCommand}">
                        <icon:GameIcons Kind="DaemonSkull"/>
                    </Button>
                    <Button Margin="2.5" Command="{Binding ViewModel.AddHazardCommand}">
                        <icon:GameIcons Kind="HazardSign"/>
                    </Button>
                    <mah:SplitButton Margin="2.5" SelectedIndex="{Binding ViewModel.SelectedTrashItem}" Command="{Binding ViewModel.RemoveCombatItemCommand}">
                        <mah:SplitButton.Icon>
                            <icon:ForkAwesome Kind="Trash"/>
                        </mah:SplitButton.Icon>

                        <mah:SplitButton.Items>
                            <ListBoxItem ToolTip="Selected">
                                <icon:GameIcons Kind="Select"/>
                            </ListBoxItem>
                            <ListBoxItem ToolTip="Players">
                                <icon:GameIcons Kind="TabletopPlayers"/>
                            </ListBoxItem>
                            <ListBoxItem ToolTip="Non Player Characters">
                                <icon:GameIcons Kind="DaemonSkull"/>
                            </ListBoxItem>
                            <ListBoxItem ToolTip="Hazards">
                                <icon:GameIcons Kind="HazardSign"/>
                            </ListBoxItem>
                            <ListBoxItem ToolTip="Everything">
                                <icon:Material Kind="AllInclusive"/>
                            </ListBoxItem>
                        </mah:SplitButton.Items>
                    </mah:SplitButton>
                </StackPanel>
                
                <ItemsControl Grid.Row="1" Grid.Column="2" Grid.ColumnSpan="5" ItemsSource="{Binding ViewModel.Items}" d:ItemsSource="{d:SampleData ItemCount=1}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <components:MyDragCanvas SelectedItem="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:RootView}}, Path=ViewModel.SelectedCombatItem, Mode=TwoWay}"/>
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Tag="{Binding}">
                                <Rectangle Width="250" Height="35" RadiusX="15" RadiusY="15" StrokeThickness="3" 
                                           Stroke="{Binding Converter={StaticResource typeToColor}}" 
                                           Fill="{StaticResource Application.Brushes.Solid.Parchment}"/>
                                <Rectangle Width="50" RadiusX="15" RadiusY="15" HorizontalAlignment="Right" 
                                           Fill="{Binding Converter={StaticResource typeToColor}}"/>
                                <Rectangle Width="25" HorizontalAlignment="Right" Margin="40,3" Fill="#FFEAD8C1"/>
                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" Margin="5,0,40,0" Foreground="{StaticResource Application.Brushes.Solid.Label}"/>
                                <TextBlock Text="{Binding Converter={StaticResource shortName}}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                           Width="50" TextAlignment="Center" Foreground="{StaticResource Application.Brushes.Solid.Parchment}"/>
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ScrollViewer Grid.Row="1" Grid.Column="7" VerticalScrollBarVisibility="Auto">
                    <components:NonPlayerCharacterPanel DataContext="{Binding ViewModel.SelectedCombatItem}"
                                                        ShowAbilityModifiers="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:RootView}}, Path=ViewModel.Config.ShowModifiers}"
                                                        ShowAbilitySaves="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:RootView}}, Path=ViewModel.Config.ShowSaves}"
                                                        DialogCoordinator="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:RootView}}, Path=ViewModel.DialogCoordinator}"
                                                        DialogCoordinatorViewModel="{Binding RelativeSource={RelativeSource Mode=FindAncestor, AncestorType={x:Type local:RootView}}, Path=ViewModel}"
                                                        />
                </ScrollViewer>
            </Grid>
        </Grid>

        <Grid Grid.Row="2" HorizontalAlignment="Right" VerticalAlignment="Bottom"
              Margin="10">

            <Label Foreground="{StaticResource MahApps.Brushes.SliderTrack.Normal}">Zoom:</Label>
            <Slider Width="150" Margin="45,0,0,0" Value="{Binding ViewModel.Zoom}" Minimum="1" Maximum="3"></Slider>
        </Grid>
    </Grid>
</mah:MetroWindow>
